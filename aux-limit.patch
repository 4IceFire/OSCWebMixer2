 /**
  * Build initial configuration for new connections
  * @returns - the initial configuration
  */
+
+/**
+ * Return true if aux n (1-based) is web-allowed
+ */
+function isAuxAllowed(n) {
+	if(!config.web || !Array.isArray(config.web.allowedAuxes) || config.web.allowedAuxes.length === 0) {
+		return true; // no restriction configured
+	}
+	return config.web.allowedAuxes.includes(Number(n));
+}
+
+/**
+ * Extract aux number from an OSC address, if present.
+ * Supports: /Aux_Outputs/<n>/... and /Input_Channels/<ch>/Aux_Send/<n>/...
+ * Returns Number or null.
+ */
+function extractAuxFromAddress(address) {
+	let m = address.match(/^\/Aux_Outputs\/(\d+)\//);
+	if(m) return Number(m[1]);
+	m = address.match(/^\/Input_Channels\/(\d+)\/Aux_Send\/(\d+)\//);
+	if(m) return Number(m[2]);
+	return null;
+}
 
